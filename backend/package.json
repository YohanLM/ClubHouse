{
  "name": "@clubhouse/backend",
  "version": "0.1.0",
  "private": true,
  "description": "ClubHouse service layer (account, club and event services)",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "prisma:generate": "prisma generate --schema=./prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema=./prisma/schema.prisma",
    "reset:test-data": "node ./scripts/resetTestData.js",
    "prepare": "prisma generate --schema=./prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.8.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "jest": "^30.5.2",
    "prisma": "^5.8.0",
    "ts-jest": "^29.4.14",
    "typescript": "~6.0.3"
  }
}
