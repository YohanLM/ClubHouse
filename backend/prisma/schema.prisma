datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Account {
  id                   Int      @id @default(autoincrement())
  email                String   @unique
  name                 String
  passwordHash         String
  role                 String   @default("User")
  faculty              String?
  studyYear            String?
  failedLoginAttempts  Int      @default(0)
  lockedUntil          DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}
